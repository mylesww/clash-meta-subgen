{
  "name": "clash-meta-subgen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "cloudflare": {
    "bindings": {
      "ACCESS_TOKEN": {
        "description": "用于 `/sub?token=...` 鉴权的访问令牌。请设置一个足够复杂的值"
      },
      "RESULT_CACHE_TTL_SECONDS": {
        "description": "生成后的订阅缓存时长，单位为秒。默认值为 `300`。"
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --project web/tsconfig.json && tsc --project web/tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.8.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.33.2"
  }
}
